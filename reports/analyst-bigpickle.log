$(document).on('draw.dt', 'table.dataTable', function(){
    "use strict";
    var $this = $(this),
        $pagination = $this.next('.table-paging').add($this.closest('.dataTables_wrapper').next('.table-actions'));

    // if the table contains the 'no results' element, then hide the footer controls
    if ($this.find('tbody tr').find('.dataTables_empty').length > 0) {
        $pagination.hide();
    }
    else {
        $pagination.show();
    }
});

