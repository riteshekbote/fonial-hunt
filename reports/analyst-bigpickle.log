     *
     * @param {string} type - routes, translations, vars
     * @param data
     */
    twigData.add = function (type, data) {
        if ((type === 'routes' || type === 'translations' || type === 'vars') && typeof data === 'object') {
            for (var key in data) {
                if (data.hasOwnProperty(key)) {
                    twigData[type][key] = data[key];
                }
            }
        }
        else {
            console.log('Type must be either "routes", "translations" or "vars". Data must be an object.');
        }
    };

})(window.twigData = window.twigData || {});

