$(document).ajaxStart(function(){
    "use strict";
    var $modal = $('#modal'),
        $dataTableProcessing = $('#dataTable_processing'),
        $sweetAlert = $('.showSweetAlert');

    if (!$bgTask) {
        if ($dataTableProcessing.is(':hidden')) {
            if ($modal.is(':visible')) {
                $modal.find('.modal-content').LoadingOverlay('show');
            }
            else if ($sweetAlert.is(':visible')) {
                $sweetAlert.LoadingOverlay('show');
            }
            else {
                $.LoadingOverlay('show');
            }
        }

        else if ($dataTableProcessing.is(':visible')) {
            return;
        }
        else {
            if ($modal.is(':visible')) {
                $modal.find('.modal-content').LoadingOverlay('show');
            }
            else if ($sweetAlert.is(':visible')) {
                $sweetAlert.LoadingOverlay('show');
            }
            else {
                $.LoadingOverlay('show');
            }
        }
    }

    // reset polling
    $bgTask = false;

}).ajaxComplete(function(){
    "use strict";
    var $modal = $('#modal'),
        $sweetAlert = $('.showSweetAlert');

    if ($modal.is(':visible')) {
        $modal.find('.modal-content').LoadingOverlay('hide');
    }
    else if ($sweetAlert.is(':visible')) {
        $sweetAlert.LoadingOverlay('hide');
    }
    else {
        $.LoadingOverlay('hide');
    }
});
