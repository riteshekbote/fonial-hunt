// Next conference timer

var currentConferenceDuration = function() {
    "use strict";
    var $countdown = $('.current-conference-duration'),
        $timeCounter = $countdown.find('.time-counter'),
        $timeStart = $timeCounter.data('start-time') * 1000,
        duration = countdown($timeStart, null, countdown.SECONDS),
        seconds = duration.seconds,

        updateTimer = function ()
        {
            seconds++;
            var hh = parseInt(seconds/3600, 10),
                mm = parseInt(seconds/60, 10),
                ss,
                remainingSeconds,
                unit;

            if (hh > 0) {
                remainingSeconds = seconds - (hh * 3600);
                mm = padding(parseInt(remainingSeconds / 60, 10));
                ss = padding(remainingSeconds%60);
                unit = twigData.translations.hours;
                $timeCounter.html(hh + ':' + mm + ':' + ss + ' ' + unit);
            }

            else if (mm > 0) {
                mm = padding(parseInt(seconds / 60, 10));
                ss = padding(seconds % 60);
                unit = twigData.translations.minutes;
                $timeCounter.html(mm + ':' + ss + ' ' + unit);
            }

            else {
                ss = padding(seconds % 60);
                unit = twigData.translations.seconds;
                $timeCounter.html(ss + ' ' + unit);
            }

        },
        padding = function (val)
        {
            return val > 9 ? val : "0" + val;
        };

    setInterval(updateTimer, 1000);
};

