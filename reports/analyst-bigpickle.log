                $(target).html('<h1 style="color: red; text-align: center">Seite nicht gefunden.</h1>');
            } else {
                $(target).html('<h1 style="color: red; text-align: center">ERROR</h1>');
            }
        }).done(function(response){
            if (target !== null) {
                if (append === true) {
                    $(target).append(response);
                    if(customclass !== null){
                        $(target).addClass(customclass);
                    }
                }
                else {
                    $(target).html(response);
                }
            }
            else if (!callback && target === null) {
                return response;
            }
        }).always(function(response){
            if (callback) {
                callback(response);
            }
        });
    };

