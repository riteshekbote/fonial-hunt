    <script>
        function checkCookie(){
            var cookieEnabled=(navigator.cookieEnabled)? true : false;
            if (typeof navigator.cookieEnabled=="undefined" && !cookieEnabled){
                document.cookie="testcookie";
                cookieEnabled=(document.cookie.indexOf("testcookie")!=-1)? true : false;
            }
            return (cookieEnabled)?true:showCookieFail();
        }

        function showCookieFail() {
            $('.forgot-password').after(
                '<div class="row">' +
                    '<div class="col-lg-12 col-md-12 col-sm-12 col-xs-12">' +
                        '<p class="small text-center margin-top-30"><strong>Keine Cookies aktiviert?</strong> <br>Sie haben den Einsatz von Cookies in Ihrem Browser deaktiviert. Um sich bei fonial registrieren zu können, müssen Sie Cookies zulassen.</p>' +
                    '</div>' +
                '</div>'
            );
        }

        $(function(){
            var $loginForm = $('#login_form'),
                getDocHeight = function() {
                    var docHeight = window.innerHeight;
                    $loginForm.css('min-height', docHeight);
                };

            getDocHeight();

            $(window).on('resize', function(){
                getDocHeight();
            });

            checkCookie();
        });
    </script>
